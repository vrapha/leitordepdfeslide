# Porta do servidor (padrão: 8000)
PORT=8000

# Origens permitidas para CORS (separadas por vírgula)
# Em produção: coloque o domínio do Lovable
ALLOWED_ORIGINS=http://localhost:5173,https://seu-projeto.lovable.app

# --- OpenRouter (geração dos comentários) ---
# Chave criada em https://openrouter.ai/keys
# NUNCA coloque a chave real aqui — este arquivo vai para o GitHub.
# Use backend/.env (ignorado pelo git) ou as variáveis do Railway.
OPENROUTER_API_KEY=sk-or-v1-xxxxxxxx

# Modelo no formato provedor/modelo. Sem a barra, assume "openai/"
OPENROUTER_MODEL=openai/gpt-4o-mini

# Opcionais — identificam a app nos rankings do OpenRouter
OPENROUTER_SITE_URL=
OPENROUTER_APP_NAME=EMR Leitor de Slides e PDF
